# AnimeSchedule.net v3 application Bearer token.
# Get one: create a free account, then create an Application under
# https://animeschedule.net/users/<username>/settings/api
# NEVER commit the real value. In the Claude Code web sandbox this must be set
# as an environment secret (shell exports do not persist between commands).
ANIMESCHEDULE_TOKEN=

# IANA timezone the UI renders times in. Defaults to America/New_York.
APP_TIMEZONE=America/New_York

# Optional overrides (sensible defaults baked in).
# Global request budget per minute, designed to the *lower* upstream limit.
APP_RATE_PER_MIN=30
# Cache TTLs in seconds.
APP_TIMETABLE_TTL=21600   # 6h
APP_SEASONAL_TTL=86400    # 24h
